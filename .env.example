# Copie para .env.local (desenvolvimento) — NUNCA commite valores reais.
# Em produção/preview, segredos vão para o Cloudflare: `npx wrangler secret put NOME --env production`.
# Variáveis NEXT_PUBLIC_* são públicas (vão para o navegador): nunca coloque segredos nelas.

APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local: `npx supabase status` mostra os valores de desenvolvimento)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # segredo — somente servidor

# InfinitePay Checkout Integrado
INFINITEPAY_HANDLE=             # sua InfiniteTag, sem o "$"
INFINITEPAY_API_KEY=            # segredo — necessário para limitar parcelas/métodos

# Frete: none | correios | melhorenvio
SHIPPING_PROVIDER=none
CORREIOS_USER=
CORREIOS_ACCESS_CODE=           # segredo — código de acesso às APIs (CWS)
CORREIOS_CONTRACT=
CORREIOS_POSTCARD=
CORREIOS_SERVICES=03220,03298
MELHORENVIO_TOKEN=              # segredo
MELHORENVIO_SANDBOX=true
MELHORENVIO_USER_AGENT=

# E-mail: none | brevo
EMAIL_PROVIDER=none
BREVO_API_KEY=                  # segredo
EMAIL_FROM=
EMAIL_FROM_NAME=Bia Store Importados

# Rotinas agendadas (gere com: openssl rand -hex 32)
CRON_SECRET=                    # segredo

# Marketing / anti-robô (opcionais)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=                # segredo
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=           # segredo
